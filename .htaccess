#  jak.sn — SEO / Performance / Sécurité (LiteSpeed / N0C)
#  Généré par l'audit seo-perf-expert — voir AUDIT_SEO.md
# ============================================================

# --- Forcer HTTPS + version non-www (URL canonique) ---
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# --- Cache long des ressources statiques ---
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|webp|avif|svg|ico|woff2?|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fichiers qui évoluent (données + code de l'app) → toujours revalider, jamais
  # figés en immuable. Placé APRÈS le FilesMatch pour écraser la règle immuable.
  # (Les images/polices/mp4 restent immuables : c'est là que le cache long compte.)
  <FilesMatch "^(data\.(js|json)|site\.js|auth\.js|site\.css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- En-têtes de sécurité (signal de confiance) ---
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # --- Ne pas indexer la console d'administration ---
  <Files "admin.html">
    Header set X-Robots-Tag "noindex, nofollow"
  </Files>
</IfModule>

# admin.html n'est accessible que via admin.php (lecture disque côté serveur)
<Files "admin.html">
  Require all denied
</Files>

# Datastore canonique + état runtime + internes : jamais accessibles en HTTP
<Files "data.json">
  Require all denied
</Files>
RedirectMatch 404 ^/api/state/
RedirectMatch 404 ^/api/lib/
RedirectMatch 404 ^/api/tools/
RedirectMatch 404 ^/api/tests/

# --- Compression (repli si non déjà active côté serveur) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Page 404 par défaut (facultatif) ---
# ErrorDocument 404 /index.html
